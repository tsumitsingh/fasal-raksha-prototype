# Copy this file to .env and add your own keys.
HF_TOKEN=
TAVILY_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=crop-images


# Free/open model choices can be changed without editing Python.
HF_VISION_MODEL=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification
HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
AI_RESPONSE_LANGUAGE=hi

# Frontend origins allowed to call FastAPI.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500
